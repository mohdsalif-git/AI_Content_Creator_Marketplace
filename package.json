{
  "name": "genra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" --names \"client,server\" \"vite --host 0.0.0.0 --port 3000\" \"tsx watch --include .env --include server/.env server/index.js\"",
    "dev:all": "concurrently -c \"cyan,magenta\" --names \"client,server\" \"vite --host 0.0.0.0 --port 3000\" \"tsx watch --include .env --include server/.env server/index.js\"",
    "dev:server": "tsx watch --include .env --include server/.env server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node server/index.mjs",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "stop:prod": "pm2 stop ecosystem.config.cjs",
    "logs": "pm2 logs genra-backend",
    "seed": "node server/seed.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "node test-e2e.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "latest",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "latest",
    "google-auth-library": "^11.2.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "mongoose": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vite": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pm2": "^7.0.4",
    "typescript": "latest"
  }
}
