# Server Network Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database (MongoDB Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/genra?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# BytePlus ModelArk / Seedance / Seedream AI Generation
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDREAM_IMAGE_MODEL=seedream-5-0-pro
SEEDANCE_VIDEO_MODEL=seedance-2-0
MEDIA_MOCK=false

# Aliases
MEDIA_API_KEY=
MEDIA_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MEDIA_IMAGE_MODEL=seedream-5-0-pro
MEDIA_VIDEO_MODEL=seedance-2-0
